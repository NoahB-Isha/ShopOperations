# Production reverse proxy (compose `prod` profile).
#
# The campus box should NOT be exposed by router port-forwarding: put a
# Cloudflare Tunnel in front (cloudflared -> http://localhost:80). The tunnel
# terminates TLS and absorbs DDoS; Caddy just routes. If a tunnel is ever
# impossible, change :80 to the public hostname and Caddy will fetch
# Let's Encrypt certificates itself — then firewall everything except 80/443.

:80 {
	encode gzip

	# Applies to everything, SPA and proxied API alike. The backend's own
	# SecurityHeadersMiddleware sets the same values on /api/* responses; these
	# are identical, so replacing them changes nothing. The CSP is deliberately
	# NOT here — the API's is far stricter (default-src 'none') and must not be
	# widened to the SPA's. It lives in the SPA handler below.
	header {
		# Safe behind the tunnel (it terminates TLS); browsers ignore HSTS
		# received over plain http, so it is also harmless locally.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), camera=(self), microphone=()"
		# Don't advertise the proxy (or the app server behind it).
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		# SPA CSP. The API is same-origin behind this proxy (/api/*), so 'self'
		# covers it — but SUPABASE_ORIGIN must be replaced with the project's
		# Supabase origin (https://<ref>.supabase.co): that is where Supabase
		# Auth OTP and the Google OAuth start call go. Google's OAuth redirect is
		# a top-level navigation, not a fetch or a frame, so no frame-src is
		# needed — but form-action must stay 'self', never 'none'.
		# 'unsafe-inline' in style-src is unavoidable: React style={{…}} props
		# emit inline style attributes. img-src blob:/data: covers html2canvas-pro
		# snapshots and the PWA icons; worker-src blob: covers the warp WebWorker.
		# script-src is 'self' plus 'wasm-unsafe-eval': the pre-paint palette
		# script moved out of index.html into /palette.js (no hash to maintain),
		# and the barcode scanner's zxing-wasm fallback — the only decoder iOS
		# Safari has — cannot instantiate WebAssembly without that keyword.
		# camera=(self) in Permissions-Policy is what lets the scanner open one.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://SUPABASE_ORIGIN; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
