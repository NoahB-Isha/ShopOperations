# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# Environment & secrets — never commit credentials
.env
.env.*
!.env.example

# PII workbooks — never commit personal data. The coordinator roster holds ~58
# emails, ~66 phone numbers, addresses and Stripe terminal serials; it lives in
# ./private/ on each host and is mounted read-only into the containers.
/private/
docs/reference/*.xlsx
# EXCEPTION: the forecasting workbook MUST stay tracked — it is the spec of
# record for tests/test_workbook_parity.py and contains no personal data.
!docs/reference/USA INV CHK.xlsx

# Generated data (demo fixtures, local caches, sqlite scratch DBs)
backend/data/
*.sqlite3
*.db

# OS / editor
.DS_Store
.idea/
.vscode/

# database dumps (deploy migration artifacts — never commit)
/backups/
