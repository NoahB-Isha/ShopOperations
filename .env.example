# ============================================================================
# Isha Life Shop Ops — environment
# Copy to `.env` and fill in. The defaults below give a fully working local
# demo with NO real credentials: fixture-mode Odoo, dev-mode auth, local DB.
# Secrets live here and only here — never in the repo, logs, or URLs.
# ============================================================================

ENV=dev
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Local dev: the compose Postgres below. Production: the Supabase Postgres
# connection string (use the pooled connection string; treat it as plain
# Postgres — no Supabase-specific features in app code).
DATABASE_URL=postgresql+psycopg://ilops:ilops@db:5432/ilops
POSTGRES_USER=ilops
POSTGRES_PASSWORD=ilops
POSTGRES_DB=ilops

# --- Auth ------------------------------------------------------------------
# dev      = backend issues one-time codes itself and RETURNS the code in the
#            API response (clearly marked; for local demo only).
# supabase = frontend does email/SMS OTP via Supabase Auth; backend verifies
#            the Supabase JWT and exchanges it for an app session.
AUTH_MODE=dev
APP_JWT_SECRET=dev-only-change-me
SESSION_DAYS=30
OTP_EXP_MINUTES=10

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Odoo ------------------------------------------------------------------
# Leave all four blank to run in FIXTURE MODE: sync reads recorded/generated
# fixture files instead of the live instance, and all writes are dry-runs.
ODOO_BASE_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_PASSWORD=

# Global kill switch. false = every write operation app-wide renders a
# dry-run instead of writing. Flip to true only after the canary protocol.
ODOO_WRITES_ENABLED=false

# Polite-client tuning
ODOO_PAGE_SIZE=1000
ODOO_THROTTLE_SECONDS=0.25
ODOO_TIMEOUT_SECONDS=120

# Deep links to records the app creates ({base}, {model}, {id} substituted)
ODOO_RECORD_URL_TEMPLATE={base}/web#id={id}&model={model}&view_type=form

# --- Sync cadence (minutes) --------------------------------------------------
# Stock/incoming a few times a day; products twice a day; sales hourly
# incrementals (current month only; previous month re-pulled once daily).
SYNC_PRODUCTS_MINUTES=720
SYNC_STOCK_MINUTES=240
SYNC_SALES_MINUTES=60
SYNC_INCOMING_MINUTES=240
SYNC_STALE_FACTOR=2.0
SALES_BACKFILL_MONTHS=24

# --- Seeds / imports ---------------------------------------------------------
SEED_COORDINATOR_XLSX=docs/reference/IL City Coordinators.xlsx

# --- Ports (compose) ---------------------------------------------------------
API_PORT=8000
WEB_PORT=5173
