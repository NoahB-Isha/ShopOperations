# ============================================================================
# Isha Life Shop Ops — environment
# Copy to `.env` and fill in. The defaults below give a fully working local
# demo with NO real credentials: fixture-mode Odoo, dev-mode auth, local DB.
# Secrets live here and only here — never in the repo, logs, or URLs.
# ============================================================================

ENV=dev
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Local dev: the compose Postgres below. Production: the Supabase Postgres
# connection string (use the pooled connection string; treat it as plain
# Postgres — no Supabase-specific features in app code).
DATABASE_URL=postgresql+psycopg://ilops:ilops@db:5432/ilops
POSTGRES_USER=ilops
POSTGRES_PASSWORD=ilops
POSTGRES_DB=ilops

# --- Auth ------------------------------------------------------------------
# dev      = backend issues one-time codes itself and RETURNS the code in the
#            API response, so anyone who can reach the server can sign in as
#            anyone. Local demo ONLY — the app refuses to start with this
#            outside a dev/test/local ENV.
# supabase = frontend does email/SMS OTP via Supabase Auth; backend verifies
#            the Supabase JWT and exchanges it for an app session.
AUTH_MODE=dev
# Signs every session token. Ships EMPTY on purpose: a committed placeholder is
# a public key, and the one thing worse than no secret is a shared secret that
# looks like a real one. Generate yours with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# `make dev` fills this in for you when it creates .env. Left blank in a dev
# ENV the app generates an ephemeral one per process (sessions end on restart);
# outside dev it refuses to start.
APP_JWT_SECRET=
SESSION_DAYS=30
OTP_EXP_MINUTES=10

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Odoo ------------------------------------------------------------------
# Leave all four blank to run in FIXTURE MODE: sync reads recorded/generated
# fixture files instead of the live instance, and all writes are dry-runs.
ODOO_BASE_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_PASSWORD=

# Global kill switch. false = every write operation app-wide renders a
# dry-run instead of writing. Flip to true only after the canary protocol.
ODOO_WRITES_ENABLED=false

# Polite-client tuning
ODOO_PAGE_SIZE=1000
ODOO_THROTTLE_SECONDS=0.25
ODOO_TIMEOUT_SECONDS=120

# Deep links to records the app creates ({base}, {model}, {id} substituted)
ODOO_RECORD_URL_TEMPLATE={base}/web#id={id}&model={model}&view_type=form

# --- Sync cadence (minutes) --------------------------------------------------
# Stock/incoming a few times a day; products twice a day; sales hourly
# incrementals (current month only; previous month re-pulled once daily).
SYNC_PRODUCTS_MINUTES=720
SYNC_STOCK_MINUTES=240
SYNC_SALES_MINUTES=60
SYNC_INCOMING_MINUTES=240
SYNC_STALE_FACTOR=2.0
SALES_BACKFILL_MONTHS=24

# --- Seeds / imports ---------------------------------------------------------
# The coordinator roster holds personal data (~58 emails, ~66 phone numbers,
# addresses, Stripe terminal serials), so it is NOT in the repo and NOT in the
# Docker image. Copy it into ./private/ on each host — that directory is
# gitignored and mounted read-only into the containers at /app/private.
# Blank = no roster import (admins can upload it later, or POST
# /api/v1/admin/import/coordinators once the file is in place).
SEED_COORDINATOR_XLSX=private/IL City Coordinators.xlsx

# --- Ports (compose) ---------------------------------------------------------
API_PORT=8000
WEB_PORT=5173

# --- Phase 3: reasonability LLM (advisory only; rules run without it) --------
# Blank = rules-only assessments. Server-side only; never sent to the browser.
ANTHROPIC_API_KEY=
REASONABILITY_LLM_MODEL=claude-opus-4-8

# --- Phase 3: notifications (WhatsApp primary, email fallback) ---------------
# Master kill switch: false simulates every send app-wide. Per-channel feature
# flags (notify_whatsapp_live / notify_email_live) gate live sends on top.
NOTIFY_ENABLED=true
# skubot's WhatsApp bridge (POST /send, GET /status). Blank = not configured.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
# SMTP for the email fallback. Blank host = not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Isha Life Shop Ops <orders@ishalife.test>
# Where notification links point (the public app URL once tunneled)
APP_PUBLIC_URL=http://localhost:5173
